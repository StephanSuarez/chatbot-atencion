DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot
# 32 bytes en base64: openssl rand -base64 32
ENCRYPTION_KEY=

# Agendamiento con Google (006). Opcional: sin esto el chatbot no ofrece agendar citas.
# Se crean en Google Cloud → APIs y servicios → Credenciales → ID de cliente de OAuth (aplicación web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
